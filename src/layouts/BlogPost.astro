---
import Base from './Base.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import AdSlot from '../components/AdSlot.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

interface RelatedPost {
  title: string;
  slug: string;
  publishDate: Date;
}

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  tags?: string[];
  youtubeVideoId?: string;
  featuredImage?: string;
  slug: string;
  readTime: number;
  relatedPosts?: RelatedPost[];
}

const siteBase = 'https://villagefive.com';

const {
  title,
  description,
  publishDate,
  tags = [],
  youtubeVideoId,
  featuredImage,
  slug,
  readTime,
  relatedPosts = [],
} = Astro.props;

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const isoDate = publishDate.toISOString();
const canonicalURL = `${siteBase}/blog/${slug}/`;
const ogImage = featuredImage
  ? (featuredImage.startsWith('http') ? featuredImage : `${siteBase}${featuredImage}`)
  : `${siteBase}/images/villagefive_og_v3.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: ogImage,
  datePublished: isoDate,
  dateModified: isoDate,
  author: {
    '@type': 'Person',
    name: 'VillageFive',
    url: 'https://www.youtube.com/@villagefive',
  },
  publisher: {
    '@type': 'Organization',
    name: 'VillageFive',
    logo: {
      '@type': 'ImageObject',
      url: `${siteBase}/images/villagefive_og_v3.png`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
  keywords: tags.join(', '),
};

const videoJsonLd = youtubeVideoId ? {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: title,
  description: description,
  thumbnailUrl: `https://i.ytimg.com/vi/${youtubeVideoId}/maxresdefault.jpg`,
  uploadDate: isoDate,
  contentUrl: `https://www.youtube.com/watch?v=${youtubeVideoId}`,
  embedUrl: `https://www.youtube.com/embed/${youtubeVideoId}`,
} : null;
---

<Base
  title={`${title} | VillageFive`}
  description={description}
  ogImage={ogImage}
  ogType="article"
  canonicalURL={canonicalURL}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  {videoJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(videoJsonLd)} slot="head" />
  )}
  <meta property="article:published_time" content={isoDate} slot="head" />
  {tags.map(tag => <meta property="article:tag" content={tag} slot="head" />)}

  <article class="blog-post">
    <div class="container">
      <div class="blog-post-layout">
        <!-- Main content -->
        <div class="blog-post-content">
          <header class="blog-post-header">
            {tags.length > 0 && (
              <div class="blog-post-tags">
                {tags.map(tag => (
                  <span class="badge badge-sm badge-ember">{tag}</span>
                ))}
              </div>
            )}
            <h1 class="blog-post-title">{title}</h1>
            <div class="blog-post-meta">
              <time datetime={isoDate}>{formattedDate}</time>
              <span class="blog-post-meta-sep">&middot;</span>
              <span>{readTime} min read</span>
            </div>
          </header>

          {youtubeVideoId && (
            <div class="blog-post-video">
              <YouTubeEmbed videoId={youtubeVideoId} title={title} />
            </div>
          )}

          <div class="blog-post-body prose">
            <slot />
          </div>

          <AdSlot type="ad" label="Ad Placement" />

          <!-- Newsletter CTA -->
          <div class="blog-post-newsletter">
            <NewsletterForm />
          </div>

          <!-- Related Articles -->
          {relatedPosts.length > 0 && (
            <div class="related-articles">
              <h2 class="related-articles-title">More Stories</h2>
              <div class="related-articles-grid">
                {relatedPosts.map(post => (
                  <a href={`/blog/${post.slug}/`} class="related-article-card card">
                    <div class="related-article-body">
                      <div class="related-article-title">{post.title}</div>
                      <div class="related-article-meta">
                        {post.publishDate.toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric',
                        })}
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <aside class="blog-post-sidebar">
          <div class="sidebar-sticky">
            <div class="sidebar-subscribe">
              <div class="sidebar-subscribe-title">Never Miss a Story</div>
              <p class="sidebar-subscribe-desc">New disaster documentaries every week.</p>
              <a
                class="btn btn-primary btn-md"
                href="https://www.youtube.com/@villagefive?sub_confirmation=1"
                target="_blank"
                rel="noopener noreferrer"
                style="width: 100%;"
              >
                Subscribe on YouTube
              </a>
            </div>
            <AdSlot type="affiliate" label="Affiliate Placement" />
          </div>
        </aside>
      </div>
    </div>
  </article>
</Base>

<style>
  .sidebar-subscribe {
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    text-align: center;
  }

  .sidebar-subscribe-title {
    font-family: var(--font-display);
    font-size: var(--type-lg);
    letter-spacing: var(--ls-wide);
    color: var(--ember-400);
    margin-bottom: var(--space-2);
  }

  .sidebar-subscribe-desc {
    font-family: var(--font-body);
    font-size: var(--type-sm);
    color: var(--text-secondary);
    line-height: var(--lh-relaxed);
    margin-bottom: var(--space-4);
  }

  /* ── Related Articles ───────────────────────────────────────── */
  .related-articles {
    margin-top: var(--space-12);
    padding-top: var(--space-10);
    border-top: 1px solid var(--border-subtle);
  }

  .related-articles-title {
    font-family: var(--font-display);
    font-size: var(--type-xl);
    letter-spacing: var(--ls-wide);
    margin-bottom: var(--space-6);
  }

  .related-articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .related-article-card {
    display: block;
    text-decoration: none;
  }

  .related-article-body {
    padding: var(--space-5);
  }

  .related-article-title {
    font-family: var(--font-condensed);
    font-size: var(--type-md);
    font-weight: 700;
    line-height: var(--lh-snug);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .related-article-meta {
    font-family: var(--font-condensed);
    font-size: var(--type-xs);
    color: var(--text-tertiary);
    letter-spacing: var(--ls-wide);
  }

  @media (max-width: 768px) {
    .related-articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
