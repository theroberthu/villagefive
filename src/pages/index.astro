---
import Base from '../layouts/Base.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import VideoCard from '../components/VideoCard.astro';
import videos from '../data/videos.json';

const latestVideo = videos[0];
const recentVideos = videos.slice(1, 7);

const orgSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "VillageFive",
  "url": "https://villagefive.com",
  "description": "VillageFive covers the disasters history forgot. Weekly documentaries on forgotten catastrophes, survivor stories, and the events that changed the world.",
  "sameAs": [
    "https://www.youtube.com/@villagefive",
    "https://www.instagram.com/villagefive",
    "https://x.com/theroberthu",
    "https://www.tiktok.com/@village.five"
  ]
});

const videoSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": latestVideo.title,
  "description": latestVideo.title,
  "thumbnailUrl": latestVideo.thumbnail,
  "uploadDate": latestVideo.publishDate,
  "embedUrl": `https://www.youtube.com/embed/${latestVideo.id}`,
  "contentUrl": `https://www.youtube.com/watch?v=${latestVideo.id}`,
  "publisher": {
    "@type": "Organization",
    "name": "VillageFive",
    "url": "https://villagefive.com"
  }
});
---

<Base
  title="VillageFive | Forgotten Disasters, Survivor Stories & History"
  description="VillageFive covers the disasters history forgot. Weekly documentaries on forgotten catastrophes, survivor stories, and the events that changed the world."
  canonicalURL="https://villagefive.com/"
>
  <script type="application/ld+json" set:html={orgSchema} slot="head" />
  <script type="application/ld+json" set:html={videoSchema} slot="head" />

  <!-- Hero -->
  <section class="hero-atmo corner-brackets">
    <div class="container">
      <div class="hero-columns">
        <div class="hero-text">
          <div class="hero-eyebrow">The Stories History Left Behind</div>
          <h1 class="hero-title">VILLAGE<em>FIVE</em></h1>
          <p class="hero-sub">
            Forgotten disasters, survivor stories, and the catastrophic events that changed history. New documentaries every week.
          </p>
          <div class="hero-actions">
            <a
              class="btn btn-primary btn-xl"
              href="https://www.youtube.com/@villagefive?sub_confirmation=1"
              target="_blank"
              rel="noopener noreferrer"
            >
              Subscribe on YouTube
            </a>
            <a
              class="btn btn-secondary btn-xl"
              href="#latest-video"
            >
              Watch Latest
            </a>
          </div>
        </div>
        <div class="hero-featured">
          <a
            class="hero-featured-link"
            href={`https://www.youtube.com/watch?v=${latestVideo.id}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              src={latestVideo.thumbnail}
              alt={latestVideo.title}
              width="640"
              height="360"
              class="hero-featured-img"
              loading="eager"
            />
            <div class="hero-featured-overlay">
              <svg class="hero-play-icon" viewBox="0 0 68 48" width="68" height="48">
                <path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="rgba(232,66,10,0.9)"/>
                <path d="M45 24L27 14v20" fill="#fff"/>
              </svg>
            </div>
            <div class="hero-featured-title">{latestVideo.title}</div>
          </a>
        </div>
      </div>
      <div class="hero-story">
        <p>
          Thousands of disasters have shaped the world we live in today. Earthquakes that leveled entire cities. Floods that killed hundreds of thousands. Explosions that wiped towns off the map. Most of them never made it into a textbook.
        </p>
        <p>
          VillageFive covers the disasters that history forgot: the ones too devastating to ignore, but somehow overlooked. Every week, a new documentary brings one of these stories back to light through research, real accounts, and the details that got buried over time.
        </p>
        <p>
          From the 1889 Johnstown Flood to the 2026 Ice Storm, these aren't just tragedies. They're warnings.
        </p>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="stats-bar">
    <div class="container">
      <div class="stats-row">
        <div class="stat">
          <span class="stat-number">2,200+</span>
          <span class="stat-label">Subscribers</span>
        </div>
        <div class="stat">
          <span class="stat-number">680+</span>
          <span class="stat-label">Videos</span>
        </div>
        <div class="stat">
          <span class="stat-number">50+</span>
          <span class="stat-label">Disasters Covered</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Video -->
  <section class="section-wrap" id="latest-video">
    <div class="container">
      <div class="section-header">
        <h2>Latest Video</h2>
        <p>Most recent upload</p>
      </div>
      <YouTubeEmbed videoId={latestVideo.id} title={latestVideo.title} />
    </div>
  </section>

  <!-- Recent Videos -->
  <section class="section-wrap">
    <div class="container">
      <div class="section-header">
        <h2>Recent Videos</h2>
        <p>From the archive</p>
      </div>
      <div class="video-grid">
        {recentVideos.map(video => (
          <VideoCard
            id={video.id}
            title={video.title}
            publishDate={video.publishDate}
            thumbnail={video.thumbnail}
          />
        ))}
      </div>
      <div class="view-all">
        <a
          class="btn btn-secondary btn-lg"
          href="https://www.youtube.com/@villagefive/videos"
          target="_blank"
          rel="noopener noreferrer"
        >
          View All on YouTube
        </a>
      </div>
    </div>
  </section>

  <!-- Subscribe CTA -->
  <section class="section-wrap">
    <div class="container">
      <div class="subscribe-cta">
        <h2 class="subscribe-cta-title">Don't Miss a Story</h2>
        <p class="subscribe-cta-desc">
          New disaster stories every week. Subscribe on YouTube to stay updated.
        </p>
        <a
          class="btn btn-primary btn-xl"
          href="https://www.youtube.com/@villagefive?sub_confirmation=1"
          target="_blank"
          rel="noopener noreferrer"
        >
          Subscribe on YouTube
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Atmospheric Hero ───────────────────────────────────── */
  .hero-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero-columns {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-10);
    }
  }

  .hero-featured {
    position: relative;
  }

  .hero-featured-link {
    display: block;
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg), 0 0 40px rgba(232,66,10,0.15);
    transition: transform var(--ease-out) 0.3s, box-shadow var(--ease-out) 0.3s;
  }

  .hero-featured-link:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg), 0 0 60px rgba(232,66,10,0.25);
  }

  .hero-featured-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-featured-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.3);
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
  }

  .hero-featured-link:hover .hero-featured-overlay {
    opacity: 1;
  }

  .hero-play-icon {
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.5));
  }

  .hero-featured-title {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-6) var(--space-4) var(--space-3);
    background: linear-gradient(transparent, rgba(0,0,0,0.85));
    font-family: var(--font-condensed);
    font-size: var(--type-base);
    font-weight: 600;
    color: var(--ash-000);
    letter-spacing: var(--ls-normal);
  }

  .hero-atmo {
    padding: var(--space-16) 0 var(--space-12);
    position: relative;
    overflow: hidden;
    background:
      /* Grid lines */
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 39px,
        rgba(232,66,10,0.06) 39px,
        rgba(232,66,10,0.06) 40px
      ),
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 39px,
        rgba(232,66,10,0.06) 39px,
        rgba(232,66,10,0.06) 40px
      ),
      /* Ember glow center */
      radial-gradient(
        ellipse 60% 50% at 50% 40%,
        rgba(232,66,10,0.15) 0%,
        rgba(232,66,10,0.04) 50%,
        transparent 80%
      ),
      /* Dark vignette */
      radial-gradient(
        ellipse 80% 70% at 50% 50%,
        transparent 30%,
        rgba(13,13,13,0.6) 100%
      ),
      var(--surface-base);
  }

  .hero-story {
    max-width: 600px;
    margin-top: var(--space-10);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-8);
  }

  .hero-story p {
    font-family: var(--font-body);
    font-size: var(--type-base);
    color: var(--text-secondary);
    line-height: var(--lh-relaxed);
    margin-bottom: var(--space-4);
  }

  .hero-story p:last-child {
    margin-bottom: 0;
  }

  /* ── Stats Bar ──────────────────────────────────────────── */
  .stats-bar {
    padding: var(--space-8) 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    text-align: center;
  }

  .stat-number {
    display: block;
    font-family: var(--font-display);
    font-size: var(--type-2xl);
    color: var(--ember-400);
    letter-spacing: var(--ls-wide);
    line-height: 1;
    margin-bottom: var(--space-1);
  }

  .stat-label {
    font-family: var(--font-condensed);
    font-size: var(--type-sm);
    color: var(--text-tertiary);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
  }

  /* ── View All Link ─────────────────────────────────────── */
  .view-all {
    text-align: center;
    margin-top: var(--space-8);
  }

  /* ── Subscribe CTA ─────────────────────────────────────── */
  .subscribe-cta {
    text-align: center;
    padding: var(--space-12) 0;
  }

  .subscribe-cta-title {
    font-family: var(--font-display);
    font-size: var(--type-2xl);
    letter-spacing: var(--ls-wide);
    margin-bottom: var(--space-3);
  }

  .subscribe-cta-desc {
    font-size: var(--type-md);
    color: var(--text-secondary);
    line-height: var(--lh-relaxed);
    max-width: 480px;
    margin: 0 auto var(--space-8);
  }
</style>
