---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const words = (post.body || '').split(/\s+/).length;
const readTime = Math.max(1, Math.ceil(words / 230));
const slug = post.id.replace(/\.md$/, '');

// Find related posts by matching tags
const allPosts = await getCollection('blog');
const currentTags = post.data.tags || [];

const relatedPosts = allPosts
  .filter(p => p.id !== post.id)
  .map(p => {
    const pTags = p.data.tags || [];
    const overlap = currentTags.filter((t: string) => pTags.includes(t)).length;
    return { post: p, overlap };
  })
  .sort((a, b) => {
    // Sort by tag overlap first, then by date
    if (b.overlap !== a.overlap) return b.overlap - a.overlap;
    return new Date(b.post.data.publishDate).getTime() - new Date(a.post.data.publishDate).getTime();
  })
  .slice(0, 4)
  .map(({ post: p }) => ({
    title: p.data.title,
    slug: p.id.replace(/\.md$/, ''),
    publishDate: p.data.publishDate,
  }));
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  publishDate={post.data.publishDate}
  tags={post.data.tags}
  youtubeVideoId={post.data.youtubeVideoId}
  featuredImage={post.data.featuredImage}
  slug={slug}
  readTime={readTime}
  relatedPosts={relatedPosts}
>
  <Content />
</BlogPost>
